# Load the JSON bib
load json

# Parse a JSON string into a Fries dict
let data = json_parse("{\"name\": \"Fries\", \"version\": 1, \"awesome\": true}")

# Access and inspect
println(data)
println(json_keys(data))
println(json_get(data, "name"))
println(json_has(data, "version"))

# Immutable update - json_set returns a new dict
let updated = json_set(data, "cool", true)
println(json_stringify(updated))

# Stringify back to JSON
println(json_stringify(data))

# Keys and values
println(json_values(data))